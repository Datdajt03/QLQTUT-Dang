\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tbu_report}[2026/08/12 TBU Report Style Package]

% --- Các gói phụ thuộc cơ bản ---
\RequirePackage{cmap}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T5]{fontenc}
\RequirePackage[utf8]{vietnam}
\RequirePackage[a4paper, top=20mm, bottom=20mm, left=30mm, right=15mm, footskip=0pt]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{setspace}         % Giãn dòng
\RequirePackage{graphicx}         % Chèn hình ảnh
\RequirePackage{tikz}             % Vẽ khung bìa
\usetikzlibrary{calc, positioning, fit, backgrounds, shapes.geometric}
\RequirePackage{titlesec}         % Định dạng tiêu đề chương/mục
\RequirePackage{caption}          % Định dạng chú thích hình/bảng
\RequirePackage{fancyhdr}         % Định dạng trang header/footer
\RequirePackage{tocloft}          % Định dạng mục lục
\RequirePackage{array}            % Định dạng bảng
\RequirePackage{longtable}        % Bảng nhiều trang
\RequirePackage{booktabs}         % Đường kẻ bảng chuyên nghiệp
\RequirePackage{enumitem}         % Danh sách liệt kê
%\RequirePackage{indentfirst}      % Thụt đầu dòng đoạn văn đầu tiên
\RequirePackage[hidelinks, unicode, pdfencoding=auto]{hyperref} % Liên kết PDF

% --- Cấu hình giãn dòng và khoảng cách đoạn ---
\setstretch{1.3}                 % Giãn dòng 1.3 chuẩn báo cáo
\setlength{\parindent}{0pt}       % Không thụt đầu dòng (0pt)
\setlength{\parskip}{4pt}         % Khoảng cách giữa các đoạn văn 4pt

% Chống dòng mồ côi / mồ côi mục sau Bảng và ngắt trang xấu
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=10000
\displaywidowpenalty=10000

% Cấu hình Float (Bảng và Hình) tránh nhảy ngắt trang bất hợp lý
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.85}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.75}
\setlength{\floatsep}{8pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{10pt plus 2pt minus 2pt}
\setlength{\intextsep}{10pt plus 2pt minus 2pt}

% --- Cấu hình phân cấp danh sách (Itemize & Enumerate) ---
\setlist[enumerate,1]{label=\arabic*., leftmargin=*, align=left}
\setlist[enumerate,2]{label=\alph*), leftmargin=*, align=left}
\setlist[itemize,1]{label=--, leftmargin=*, align=left}
\setlist[itemize,2]{label=+, leftmargin=*, align=left}

% --- Cấu hình chú thích Hình ảnh và Bảng biểu ---
\captionsetup[figure]{name={Hình}, labelsep=colon, labelfont=bf, font=small, justification=centering}
\captionsetup[table]{name={Bảng}, labelsep=period, labelfont=bf, font=small, position=top, skip=6pt}

% --- Định dạng Trang Header / Footer ---
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage} % Số trang ở chính giữa phía dưới
\renewcommand{\headrulewidth}{0pt} % Không kẻ đường ranh giới header
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% --- Cấu hình Định dạng Tiêu đề Đồng bộ 12pt (Titlesec) ---
\titleformat{\chapter}[block]
{\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries\raggedright}
{\ifnum\c@secnumdepth >\m@ne CHƯƠNG \thechapter:\quad\fi}
{0pt}
{\fontsize{12pt}{14pt}\selectfont\bfseries}

\titlespacing*{\chapter}{0pt}{-24pt}{2pt}

\titleformat{\section}[block]
{\normalfont\fontsize{12pt}{15.6pt}\selectfont\bfseries}
{\thesection.}
{0.5em}
{}

\titlespacing*{\section}{0pt}{8pt plus 2pt minus 2pt}{4pt plus 1pt minus 1pt}

\titleformat{\subsection}[block]
{\normalfont\fontsize{12pt}{15.6pt}\selectfont\bfseries}
{\thesubsection.}
{0.5em}
{}

\titlespacing*{\subsection}{0pt}{6pt plus 2pt minus 2pt}{3pt plus 1pt minus 1pt}

\titleformat{\subsubsection}[block]
{\normalfont\fontsize{12pt}{15.6pt}\selectfont\bfseries\itshape}
{\thesubsubsection.}
{0.5em}
{}

\titlespacing*{\subsubsection}{0pt}{5pt plus 2pt minus 1pt}{2pt plus 1pt minus 1pt}

% --- Định dạng phông chữ 12pt và căn trái cho Mục lục, Danh mục hình, Danh mục bảng (tocloft) ---
\setlength{\cftbeforetoctitleskip}{0pt}
\setlength{\cftaftertoctitleskip}{2pt}
\setlength{\cftbeforeloftitleskip}{0pt}
\setlength{\cftafterloftitleskip}{2pt}
\setlength{\cftbeforelottitleskip}{0pt}
\setlength{\cftafterlottitleskip}{2pt}

\setlength{\cftbeforechapskip}{2pt}
\setlength{\cftbeforesecskip}{0pt}
\setlength{\cftbeforesubsecskip}{0pt}

\renewcommand{\cfttoctitlefont}{\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}
\renewcommand{\cftloftitlefont}{\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}
\renewcommand{\cftlottitlefont}{\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}

\renewcommand{\cftaftertoctitle}{}
\renewcommand{\cftafterloftitle}{}
\renewcommand{\cftafterlottitle}{}

\renewcommand{\cftchapfont}{\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}
\renewcommand{\cftchappagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}
\renewcommand{\cftsecfont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftsecpagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftsubsecfont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftsubsecpagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont}

\renewcommand{\cftfigfont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftfigpagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cfttabfont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cfttabpagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont}

