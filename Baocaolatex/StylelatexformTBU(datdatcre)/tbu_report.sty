% --- Khai báo và Quản lý Danh sách Sinh viên / Thành viên ---
\newcounter{studentcount}
\setcounter{studentcount}{0}

\newcommand{\addstudent}[2][]{%
  \stepcounter{studentcount}%
  \csdef{student@name@\thestudentcount}{#2}%
  \csdef{student@tag@\thestudentcount}{#1}%
}

% Tương thích với lệnh cũ \addmember{Tên}{Vai trò}
\newcommand{\tbu@memberlist}{}
\newcommand{\addmember}[2]{%
  \g@addto@macro\tbu@memberlist{#1 & #2 \\}%
  \ifstrequal{#2}{Nhóm trưởng}{%
    \addstudent[NT]{\textbf{#1}}%
  }{%
    \ifstrequal{#2}{NT}{%
      \addstudent[NT]{\textbf{#1}}%
    }{%
      \addstudent{#1}%
    }%
  }%
}
\newcommand{\clearcontentmembers}{%
  \setcounter{studentcount}{0}%
  \gdef\tbu@memberlist{}%
}

\newcounter{tbu@loopi}
\newcounter{tbu@loopj}
\newcounter{tbu@half}

\newcommand{\tbu@renderstudentrow}[1]{%
  \setcounter{tbu@loopj}{\numexpr#1+\value{tbu@half}\relax}%
  #1. \csuse{student@name@#1}%
  \ifcsvoid{student@tag@#1}{}{ (\csuse{student@tag@#1})}%
  &%
  \ifnum\value{tbu@loopj}>\value{studentcount}\else%
    \the\value{tbu@loopj}. \csuse{student@name@\the\value{tbu@loopj}}%
    \ifcsvoid{student@tag@\the\value{tbu@loopj}}{}{ (\csuse{student@tag@\the\value{tbu@loopj}})}%
  \fi \\%
}

\newcommand{\renderstudents}{%
  \ifodd\value{studentcount}%
    \setcounter{tbu@half}{\numexpr(\value{studentcount}+1)/2\relax}%
  \else%
    \setcounter{tbu@half}{\numexpr\value{studentcount}/2\relax}%
  \fi%
  \setcounter{tbu@loopi}{1}%
  \begin{tabular}{@{} p{0.48\textwidth} p{0.48\textwidth} @{}}
    \whiledo{\value{tbu@loopi} < \numexpr\value{tbu@half}+1\relax}{%
      \expandafter\tbu@renderstudentrow\expandafter{\the\value{tbu@loopi}}%
      \stepcounter{tbu@loopi}%
    }%
  \end{tabular}%
}

% --- Khung bìa TikZ ---
\newcommand{\drawcoverborder}{%
  \begin{tikzpicture}[remember picture, overlay]
    % Khung ngoài
    \draw[line width=1.5pt]
    ($(current page.north west) + (2.5cm,-1.5cm)$)
    rectangle
    ($(current page.south east) + (-1.0cm,1.5cm)$);
    % Khung trong
    \draw[line width=0.5pt]
    ($(current page.north west) + (2.6cm,-1.6cm)$)
    rectangle
    ($(current page.south east) + (-1.1cm,1.6cm)$);
  \end{tikzpicture}%
}

% --- Lệnh tạo TRANG BÌA NGOÀI ---
\newcommand{\makeoutercover}{%
  \begin{titlepage}
    \drawcoverborder
    \centering
    \setstretch{1.3}

    % Bộ & Trường
    {\fontsize{14pt}{16pt}\selectfont \tbu@ministry \par}
    \vspace{4pt}
    {\fontsize{14pt}{16pt}\selectfont \textbf{\tbu@university} \par}

    \vspace{1.0cm}

    % Logo trường
    \IfFileExists{\tbu@logo}{%
      \includegraphics[width=3.5cm, height=3.5cm, keepaspectratio]{\tbu@logo}\par
    }{%
      \vspace{3.5cm}
    }

    \vspace{1.2cm}

    % Loại báo cáo & Tên báo cáo
    {\fontsize{14pt}{16pt}\selectfont \textbf{\tbu@reporttype} \par}
    \vspace{0.8cm}
    {\fontsize{18pt}{22pt}\selectfont \textbf{\tbu@title} \par}
    \ifx\tbu@subtitle\@empty \else
      \vspace{0.3cm}
      {\fontsize{14pt}{18pt}\selectfont \textit{\tbu@subtitle} \par}
    \fi

    \vspace{1.2cm}

    % Nhóm / Lớp
    {\fontsize{14pt}{18pt}\selectfont \textbf{\tbu@groupnumber\ - \tbu@courseclass} \par}

    \vfill

    % Địa điểm & Thời gian
    {\fontsize{14pt}{16pt}\selectfont \textbf{\tbu@location, \tbu@reportdate} \par}

  \end{titlepage}
  \cleardoublepage
}

% --- Lệnh tạo TRANG BÌA PHỤ (Có Giảng viên hướng dẫn & Sinh viên thực hiện 2 cột) ---
\newcommand{\makeinnercover}{%
  \begin{titlepage}
    \drawcoverborder
    \setstretch{1.3}

    \begin{center}
      % Bộ & Trường
      {\fontsize{14pt}{16pt}\selectfont \tbu@ministry \par}
      \vspace{4pt}
      {\fontsize{14pt}{16pt}\selectfont \textbf{\tbu@university} \par}

      \vspace{0.8cm}

      % Logo trường
      \IfFileExists{\tbu@logo}{%
        \includegraphics[width=2.8cm, height=2.8cm, keepaspectratio]{\tbu@logo}\par
      }{%
        \vspace{2.8cm}
      }

      \vspace{0.8cm}

      % Loại báo cáo & Tên báo cáo
      {\fontsize{14pt}{16pt}\selectfont \textbf{\tbu@reporttype} \par}
      \vspace{0.5cm}
      {\fontsize{18pt}{22pt}\selectfont \textbf{\tbu@title} \par}
    \end{center}

    \vspace{0.8cm}

    \begin{center}
      \begin{minipage}{0.65\textwidth}
        \setstretch{1.3}
        {\fontsize{13pt}{16pt}\selectfont
          \begin{tabular}{@{} l l @{}}
            \textbf{Giảng viên hướng dẫn:} & \tbu@advisor     \\[4pt]
            \textbf{Thực hiện:}            & \tbu@groupnumber \\
          \end{tabular}
        }\par

        \vspace{0.5cm}
        {\fontsize{13pt}{16pt}\selectfont \textbf{Sinh viên thực hiện:}\par}
        \vspace{0.3cm}
        {\fontsize{12pt}{15pt}\selectfont
          \ifnum\value{studentcount}>0
            \renderstudents
          \else
            \begin{tabular}{ll}
              \tbu@memberlist
            \end{tabular}
          \fi
        }
      \end{minipage}
    \end{center}

    \vfill

    \begin{center}
      % Địa điểm & Thời gian
      {\fontsize{14pt}{16pt}\selectfont \textbf{\tbu@location, \tbu@reportdate} \par}
    \end{center}

  \end{titlepage}
  \cleardoublepage
}

