% --- Môi trường DANH MỤC TỪ VIẾT TẮT ---
\newenvironment{abbreviations}{
  \cleardoublepage
  \chapter*{DANH MỤC TỪ VIẾT TẮT}
  \setstretch{1.3}
  \fontsize{12pt}{15pt}\selectfont
  \addtocounter{table}{-1}%
  \begin{longtable}{@{} c l @{}}
  \hline
  \textbf{Chữ viết tắt} & \textbf{Ý nghĩa} \\ \hline
  \endhead
}{
  \hline
  \end{longtable}
  \cleardoublepage
}

% --- Lệnh tạo Mục lục chuẩn ---
\newcommand{\makecontentlists}{
  \cleardoublepage
  \renewcommand{\contentsname}{MỤC LỤC}
  \tableofcontents
  \cleardoublepage
}

% --- Lệnh tạo Chương không đánh số (Mở đầu, Kết luận...) ---
\newcommand{\unchapter}[1]{%
  \cleardoublepage
  \chapter*{#1}%
  \addcontentsline{toc}{chapter}{#1}%
}

% --- Lệnh tạo Mục trong Chương không đánh số (dùng cho MỞ ĐẦU: 1.1, 1.2...) ---
\newcommand{\unsection}[2]{%
  \section*{#1. #2}%
  \addcontentsline{toc}{section}{#1. #2}%
}

